# Copy this file to .env and adjust as needed.

# Security — required header X-API-Key on /api/* (except /api/health) once enabled.
VIBRO_REQUIRE_API_KEY=false
VIBRO_API_KEY=change-me-to-a-long-random-secret

# Database (SQLite by default; point at Postgres in production, e.g.
# postgresql+psycopg2://user:pass@host:5432/vibration_monitor)
VIBRO_DATABASE_URL=sqlite:///./vibration_monitor.db

# Simulation / acquisition
VIBRO_BROADCAST_HZ=1.0
VIBRO_SNAPSHOT_EVERY_N_FRAMES=5

# CORS — add your deployed frontend origin(s)
VIBRO_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
